{
	"name": "tailwind-nextjs-starter-blog",
	"version": "2.4.0",
	"private": true,
	"packageManager": "bun@1.3.11",
	"scripts": {
		"start": "next dev",
		"dev": "cross-env INIT_CWD=$PWD next dev",
		"build": "bun x contentlayer2 build && cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
		"build:cloudflare": "cross-env EXPORT=1 UNOPTIMIZED=1 bun run build",
		"serve": "next start",
		"analyze": "cross-env ANALYZE=true next build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"prepare": "husky"
	},
	"dependencies": {
		"@kjaniec-dev/design": "0.9.3",
		"@kjaniec-dev/ui": "0.9.3",
		"github-slugger": "2.0.0",
		"kbar": "1.0.0",
		"next": "16.3.3",
		"next-themes": "0.4.6",
		"pliny": "0.4.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"web-vitals": "6.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@next/bundle-analyzer": "16.3.3",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/typography": "0.5.20",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@types/mdx": "2.0.14",
		"@types/react": "19.2.18",
		"@vitest/ui": "4.1.11",
		"contentlayer2": "0.5.8",
		"cross-env": "10.1.0",
		"hast-util-from-html-isomorphic": "2.0.0",
		"husky": "9.1.7",
		"jsdom": "30.0.1",
		"lint-staged": "17.4.1",
		"next-contentlayer2": "0.5.8",
		"postcss": "8.5.26",
		"reading-time": "1.5.0",
		"rehype-autolink-headings": "7.1.0",
		"rehype-citation": "2.3.2",
		"rehype-katex": "7.0.1",
		"rehype-katex-notranslate": "1.1.4",
		"rehype-preset-minify": "7.0.1",
		"rehype-prism-plus": "2.0.2",
		"rehype-slug": "6.0.0",
		"remark-gfm": "4.0.1",
		"remark-github-blockquote-alert": "2.1.0",
		"remark-math": "6.0.0",
		"sharp": "0.35.4",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"overrides": {
		"next-themes": "0.4.6"
	},
	"lint-staged": {
		"*.+(js|jsx|ts|tsx|json|css)": [
			"biome check --write"
		]
	}
}
